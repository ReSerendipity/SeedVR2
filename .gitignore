# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
*.whl
*.so
*.tar.gz
*.zip

# WinPython environment (local Python distribution, ~5GB)
WPy64-*/
WinPython/

# Caches / IDE / tooling local state
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
.coverage.xml
htmlcov/
.benchmarks/
prof/
*.prof
.trae/
.zcode/
.uploads/
tests/node_modules/
tests/test-results/
tests/playwright-report/
tests/blob-report/
*.tmp
*.bak
*.orig
*.rej
*~
*.lnk
*.tmproj
*.iml

# Model files
pretrained_models/*.pth
pretrained_models/*.safetensors
pretrained_models/*.bin
pretrained_models/*.pt
!pretrained_models/.gitkeep

# Data
data/uploads/*
!data/uploads/.gitkeep
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep

# Database
data/*.db
data/*.db-shm
data/*.db-wal

# IDE
.vscode/
.idea/
.idea/workspace.xml
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
Desktop.ini
System Volume Information/
$RECYCLE.BIN/

# Reference repos (development reference only, not part of the project)
repo/

# ---------------------------------------------------------------------------
# Local runtime binaries (downloadable; keep out of repo to avoid bloat)
# ---------------------------------------------------------------------------
bin/ffmpeg.exe
bin/ffprobe.exe

# ---------------------------------------------------------------------------
# Dogfood / smoke test artifacts (regenerated every run)
# ---------------------------------------------------------------------------
dogfood-output/
server_test.log
server_test_err.log
verify_output.log
test-report.md
test_report_v*.md

# ---------------------------------------------------------------------------
# UI / UX audit artifacts (dated directories + per-audit screenshots)
# NOTE: docs/screenshots/current/{dark,light}/ is REFERENCED by README and
#       must stay tracked. Only dogfood leftovers and dated audit dumps go.
# ---------------------------------------------------------------------------
docs/ui-ux-audit-*/
docs/screenshots/dogfood/

# ---------------------------------------------------------------------------
# In-repo test reports / dogfood runners (not part of the product)
# ---------------------------------------------------------------------------
tests/USER_BEHAVIOR_TEST_REPORT.md
tests/test-report.md
tests/api_test_runner.py

# Playwright visual regression snapshots (regenerated by tests)
tests/specs/uiux-compatibility.spec.ts-snapshots/*.png

# Test binary assets (regenerated / downloadable)
tests/test-assets/videos/*.mp4
tests/test-assets/images/sample.jpg
tests/test-assets/images/sample.png

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets/
data/.seedvr2_secret

# ---------------------------------------------------------------------------
# Server runtime
# ---------------------------------------------------------------------------
.server_port
nul
log.txt

# ---------------------------------------------------------------------------
# WCAG contrast test reports (regenerated by tests/wcag-contrast-test.js)
# ---------------------------------------------------------------------------
tests/wcag-reports/
